# Copia este archivo a .env.local (Vite lo carga automáticamente y ya está
# en .gitignore). Usa el proyecto de Supabase de DESARROLLO, no el de
# producción, mientras trabajas localmente.
#
# VITE_SUPABASE_URL: Settings > API > Project URL
# VITE_SUPABASE_ANON_KEY: Settings > API > Project API keys > anon public

VITE_SUPABASE_URL=https://tu-proyecto-dev.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
