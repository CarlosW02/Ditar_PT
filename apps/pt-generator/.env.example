# Copia este archivo a .env (uso local con `vercel dev`) o define estas variables
# como Environment Variables del proyecto en el dashboard de Vercel.
#
# SUPABASE_URL: URL del proyecto (Settings > API > Project URL)
# SUPABASE_ANON_KEY: clave pública "anon" (Settings > API > Project API keys > anon public)
# La anon key es segura para exponer en el cliente SIEMPRE que las tablas tengan
# Row Level Security habilitado con una política de solo lectura (ver supabase/schema.sql).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica
